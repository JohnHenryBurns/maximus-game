{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(LICENSE)",
      "Write(LICENSE)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(git status*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ]
  }
}
